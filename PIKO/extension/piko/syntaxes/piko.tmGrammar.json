{
	"scopeName": "source.piko",
	"patterns": [{ "include": "#expression" }],
	"repository": {
		"expression": {
			"patterns": [
				{ "include": "#instructions" },
				{ "include": "#numbers" },
				{ "include": "#hex_numbers" },
				
				{ "include": "#comments" }
			]
		},
		"instructions": {
			"match": "stor|strr|copi|tkst|inkr|qump ",
			"name": "keyword.instruction"
		},
		"numbers": {
			"name": "constant.numeric.decimal",
			"match": "[\\d]+"
		},
		"hex_numbers": {
			"name": "constant.numeric.hex",
			"match": "x[a-fA-F0-9]{2}"
		},

		"comments": {
			"name": "comment.inline",
			"match": "!.*"
		}
	}
}